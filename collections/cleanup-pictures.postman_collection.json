  "item": [
    {
      "id": "ca2eeda8-a08b-4a09-a42d-45e5775283dc",
      "name": "Cleanup an image",
      "request": {
        "name": "Cleanup an image",
        "description": {
          "content": "Remove objects, watermarks or blemishes from an image using a mask.\nSubmit the source image and a black/white PNG mask of the same resolution\nmarking the areas to inpaint. Returns the cleaned image as image/png.\n",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "cleanup",
            "v1"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          },
          {
            "key": "Accept",
            "value": "image/png"
          }
        ],
        "method": "POST",
        "auth": null,
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image_file",
              "type": "file",
              "description": "(Required) Source image (JPG or PNG, max 16 megapixels, max 30 MB)"
            },
            {
              "key": "mask_file",
              "type": "file",
              "description": "(Required) PNG mask (same resolution as image_file, max 30 MB). White pixels mark regions to remove."
            },
            {
              "key": "mode",
              "value": "fast",
              "type": "text",
              "description": "Processing mode. \"quality\" produces better results at higher latency. (This can only be one of fast,quality)"
            }
          ]
        }
      },
